# ═══════════════════════════════════════════════════════════════════════════
#  الكوتش الذكي 🏋️ — AI Fitness & Nutrition Coach (Telegram)
#  انسخ هذا الملف إلى .env واملأ القيم:  cp .env.example .env
#  Copy this file to .env and fill in the values:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── عام / general ───────────────────────────────────────────────────────────
APP_ENV=production            # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
TIMEZONE=UTC                  # توقيت المجدول (التذكيرات والتقارير) / scheduler tz

# ── بوت تيليجرام / Telegram bot ─────────────────────────────────────────────
# من @BotFather
BOT_TOKEN=123456789:AA-your-bot-token-here
# معرّفات الأدمن الرقمية (افصل بفاصلة) — احصل عليها من /id داخل البوت
ADMIN_IDS=111111111,222222222
# حساب الدعم المعروض للمستخدمين عند الأخطاء / حظر الحساب
SUPPORT_USERNAME=@your_support
PROTECT_CONTENT=false         # منع إعادة توجيه وسائط البوت
# TELEGRAM_API_BASE=          # خادم Bot API ذاتي الاستضافة (اختياري)

# ── Webhook (اختياري — اتركه فارغًا للعمل بـ long polling) ──────────────────
# WEBHOOK_URL=https://bot.example.com
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=change-me
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8080

# ── حالة المحادثة / FSM storage ─────────────────────────────────────────────
FSM_STORAGE=memory            # memory (عملية واحدة) | redis (عدة عمليات)
# REDIS_URL=redis://localhost:6379/0

# ── قاعدة البيانات / PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach
DB_ECHO=false
DB_AUTO_CREATE=true           # true = إنشاء الجداول عند الإقلاع (تطوير). في الإنتاج استخدم alembic
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ── تخزين الوسائط / media storage ───────────────────────────────────────────
STORAGE_BACKEND=local         # local | s3
LOCAL_MEDIA_DIR=storage/media
# PUBLIC_MEDIA_BASE_URL=https://cdn.example.com
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=            # لخدمات متوافقة مع S3 مثل R2/MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=coach-bot
# S3_ACL=
MAX_PHOTO_MB=12
PHOTO_MAX_SIDE_PX=1280        # تصغير الصورة قبل التخزين/الإرسال للذكاء الاصطناعي
PHOTO_JPEG_QUALITY=82
MEDIA_RETENTION_DAYS=180      # حذف تلقائي للصور بعد هذه المدة (خصوصية)
KEEP_FOOD_PHOTOS_DAYS=90

# ── NanoGPT (طبقة الذكاء الاصطناعي) ─────────────────────────────────────────
NANOGPT_API_KEY=nai-your-key-here
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_TIMEOUT_S=120
NANOGPT_MAX_RETRIES=2
NANOGPT_TEMPERATURE=0.75
NANOGPT_MAX_TOKENS=1600

# توزيع الموديلات حسب المهمة (حسب مواصفات المشروع)
MODEL_CONSULT=z-ai/glm-5.3-flash
MODEL_COACH=deepseek/deepseek-v4-pro
MODEL_VISION=google/gemini-3.5-flash-lite
MODEL_PLAN=deepseek/deepseek-v4-pro
MODEL_SUMMARY=z-ai/glm-5.3-flash
MODEL_STT=Whisper-Large-V3
FALLBACK_CONSULT=deepseek/deepseek-v4-flash
FALLBACK_COACH=z-ai/glm-5.3-flash
FALLBACK_VISION=google/gemini-3.5-flash
FALLBACK_STT=Wizper,gpt-4o-mini-transcribe
WEB_SEARCH_ENABLED=true       # البحث عن فيديوهات التمارين عبر NanoGPT web search
# AI_REASONING_EFFORT=        # none|low|medium|high
# توجيه متقدم بصيغة JSON: {"coach": ["deepseek/deepseek-v4-pro", "z-ai/glm-5.3-flash"]}
# MODEL_ROUTING={}

# الأسعار (USD لكل مليون توكن) — تُستخدم عند عدم إرجاع المزوّد للتكلفة
# MODEL_PRICING={"z-ai/glm-5.3-flash": [0.6, 0.6], "deepseek/deepseek-v4-pro": [1.0, 5.0]}
DEFAULT_PRICING=1.0,3.0

# ── الرسائل الصوتية / voice notes ───────────────────────────────────────────
VOICE_ENABLED=true
VOICE_MAX_SECONDS=180
VOICE_CHARGE_POINTS=0

# ── اقتصاد النقاط / points economy ──────────────────────────────────────────
POINTS_PER_USD=100            # 1 دولار = 100 نقطة
WELCOME_BONUS_POINTS=20
COACH_ACCESS_COST_POINTS=100  # زر «الكوتش الشخصي 24 ساعة»
COACH_ACCESS_DAYS=30          # 0 = فتح دائم
FOOD_SCAN_COST_POINTS=5
FOOD_SCAN_FREE_DAILY=3        # أول 3 صور أكل يوميًا مجانًا
PROGRESS_SCAN_COST_POINTS=8
REPORT_EXPORT_COST_POINTS=0
DATA_EXPORT_COST_POINTS=0
COACH_POINTS_MINIMUM=2        # سعر رسالة الكوتش (يُحسب بالتوكنز بين هذين الحدين)
COACH_POINTS_MAXIMUM=40
COACH_POINTS_PER_1K_INPUT=0.05   # نقاط لكل 1000 توكن إدخال
COACH_POINTS_PER_1K_OUTPUT=0.35  # نقاط لكل 1000 توكن إخراج
BOT_DESCRIPTION=كوتش رياضي وتغذية بالذكاء الاصطناعي

# ── حدود الاستخدام / usage caps ─────────────────────────────────────────────
CONSULT_FREE_DAILY_LIMIT=12   # استشارات عامة مجانية يوميًا
COACH_DAILY_MESSAGE_LIMIT=40
VISION_DAILY_LIMIT=30
USER_DAILY_POINTS_CAP=800
USER_MONTHLY_POINTS_CAP=12000
GLOBAL_DAILY_USD_CAP=25       # مفتاح إيقاف التكلفة على مستوى البوت كله
CAP_ACTION=degrade            # degrade (موديل أرخص) | block (رفض)

# ── الإحالة والجوائز / referral & streaks ───────────────────────────────────
REFERRAL_ENABLED=true
REFERRAL_INVITER_POINTS=25
REFERRAL_INVITEE_POINTS=15
REFERRAL_BONUS_EVERY=5        # مكافأة إضافية كل N صديق
REFERRAL_BONUS_POINTS=100
STREAK_REWARD_POINTS=10
STREAK_MILESTONES=3,7,14,30,60,100

# ── الاشتراك الدوري / auto-renewing subscription ───────────────────────────
MONTHLY_PLAN_POINTS=1500
QUARTERLY_PLAN_POINTS=4000

# ── الاشتراك الإجباري بالقناة / forced channel subscription ────────────────
FORCED_CHANNELS_ENABLED=false
FORCED_CHANNELS=@your_channel
# يمكن تعديلها لاحقًا من لوحة الأدمن دون إعادة تشغيل

# ── فيديوهات التمارين / exercise videos ─────────────────────────────────────
# YOUTUBE_API_KEY=            # اختياري — بدونها يُستخدم NanoGPT web search
YOUTUBE_LANGUAGE=ar
YOUTUBE_MAX_RESULTS=1
YOUTUBE_SAFE_SEARCH=moderate
YOUTUBE_CACHE_DAYS=30

# ── التذكيرات والتقارير / reminders & reports ───────────────────────────────
REMINDERS_ENABLED=true
WATER_REMINDER_INTERVAL_MIN=120
DEFAULT_WEIGH_IN_DAY=5        # 0=الاثنين … 6=الأحد
DEFAULT_WEIGH_IN_HOUR=8
DEFAULT_WORKOUT_HOUR=18
QUIET_HOURS_START=23          # لا إشعارات من 23:00
QUIET_HOURS_END=7             # حتى 07:00 بتوقيت المستخدم
REPORT_WEEKDAY=6              # يوم التقرير الأسبوعي
REPORT_HOUR=10
BROADCAST_BATCH_SIZE=25
BROADCAST_DELAY_MS=60

# ── حدود التغذية / nutrition safety rails ───────────────────────────────────
MIN_CALORIES_MALE=1500
MIN_CALORIES_FEMALE=1200
MAX_CALORIES=4500
MAX_DEFICIT_PCT=0.25
MAX_SURPLUS_PCT=0.20
PROTEIN_G_PER_KG_CUT=2.2
PROTEIN_G_PER_KG_BULK=1.8
PROTEIN_G_PER_KG_DEFAULT=1.8
MIN_PROTEIN_G=60

# ── الخصوصية / privacy ──────────────────────────────────────────────────────
REQUIRE_PRIVACY_CONSENT=true
# PRIVACY_POLICY_URL=https://example.com/privacy
ALLOW_DATA_EXPORT=true

# ── الخطوط العربية (للرسوم البيانية وتقارير PDF) ────────────────────────────
FONTS_DIR=assets/fonts
# ARABIC_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# ARABIC_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ── مراقبة الأخطاء (اختياري) ───────────────────────────────────────────────
# SENTRY_DSN=
